# bulletproof-compliance-jobs — example environment configuration
# Copy to .env and load it when starting the service, e.g.:
#   uvicorn app.main:app --env-file .env --host 0.0.0.0 --port 8087
# Values below are LOCAL-RUN-SAFE (relative ./state paths) — the code defaults
# use container paths (/state, /governance, /security) that match the Dockerfile.

# ==== Storage ====
SQLITE_PATH=./state/compliance_jobs.sqlite

# Audit bus sources (comma-separated SQLite paths, read-only). Point these at
# your governance-plugin audit.db and runtime-security audit_bus.sqlite.
AUDIT_BUS_DBS=./state/audit.db,./state/audit_bus.sqlite

# ==== Merkle chain ====
MERKLE_ROOTS_DIR=./state/merkle-roots
# Optional external write-once endpoint for Merkle root publishing
MERKLE_PUBLISH_URL=
MERKLE_PUBLISH_TOKEN=

# ==== Retention ====
AUDIT_RETENTION_YEARS=7
EVIDENCE_RETENTION_YEARS=7
LEGAL_HOLD_DIR=./state/legal-holds
ARCHIVE_DIR=./state/archive

# ==== DSR cascade endpoints ====
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COMPLIANCE_PORTAL_URL=http://localhost:8001
COMPLIANCE_API_TOKEN=
DSR_DELETION_CONFIRMATION_DIR=./state/dsr-confirmations

# ==== Reports ====
REPORTS_DIR=./state/regulatory-reports
REPORT_OPERATOR_ID=compliance-jobs-system

# ==== Signing (Ed25519) ====
SIGNING_KEY_DIR=./state/signing-keys

# ==== Cadence ====
MERKLE_INTERVAL_MINUTES=60
RETENTION_INTERVAL_HOURS=24
ANNUAL_CHECK_HOURS=1
NAIC_POLL_SECONDS=300

# ==== Server ====
HOST=0.0.0.0
PORT=8087
